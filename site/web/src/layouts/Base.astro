---
/**
 * Every page: the wordmark (home), Docs and Sign in, the page, a quiet footer. The look comes
 * from @brutal-ai/design's tokens; site.css only lays the pages out.
 */
import "@brutal-ai/design/tokens.css";
import "@brutal-ai/design/fonts.css";
import "@brutal-ai/design/wordmark.css";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <header class="site-header">
      <a class="brutal-wordmark brand" href="/" aria-label="Brutal, home">Brutal</a>
      <nav aria-label="Site">
        <a href="/docs">Docs</a>
        <a class="button" href="/sign-in">Sign in</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>Brutal · feedback for agents</span>
      <a href="/docs">Docs</a>
    </footer>
  </body>
</html>
