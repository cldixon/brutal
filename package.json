{
  "name": "brutal",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "worker"
  ],
  "scripts": {
    "dev": "bun run --cwd worker dev",
    "deploy": "bun run --cwd worker deploy",
    "format": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
