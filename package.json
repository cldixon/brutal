{
  "name": "brutal",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "worker",
    "app",
    "site",
    "site/web",
    "admin",
    "examples",
    "eval"
  ],
  "scripts": {
    "dev": "bun run --cwd worker dev",
    "deploy": "bun run --cwd worker deploy",
    "format": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "pack": "bun scripts/pack.ts",
    "build": "bun run --cwd app build && bun run --cwd site build",
    "admin": "bun scripts/admin.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
